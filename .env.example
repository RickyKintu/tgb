# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real API keys.

# Rain.gg affiliate API key, used server-side only (src/lib/rain.ts) to pull
# the live "Buddy Leaderboard" race data. Get this from your Rain.gg
# affiliate dashboard. Without it, the Leaderboard section falls back to the
# static placeholder data in src/config/leaderboard.ts.
RAIN_API_KEY=
